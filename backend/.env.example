 # Salin file ini menjadi .env lalu sesuaikan dengan setup lokal masing-masing
# (Windows: XAMPP/Laragon | Mac: DBngin/Herd) — port & user bisa beda.

PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_akuntansi

JWT_SECRET=ganti_dengan_string_rahasia_yang_panjang
JWT_EXPIRES_IN=8h

# URL frontend React (untuk konfigurasi CORS)
FRONTEND_URL=http://localhost:5173
